
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id           Int       @id @default(autoincrement())
  name         String
  username     String?   @unique
  passwordHash String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders       Order[]
  sessions     Session[]

  restaurantOrders RestaurantOrder[]

  menuItems MenuItem[]
}

model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())

  sessions     Session[]
}

model Courier {
  id           Int       @id @default(autoincrement())
  name         String
  username     String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  orders       Order[]
}

enum OrderStatus {
  PENDING
  ASSIGNED
  REJECTED
  PICKED_UP
  DELIVERED
  CANCELED
}

model Order {
  id            Int         @id @default(autoincrement())
  businessId    Int
  courierId     Int?
  customerName  String
  customerPhone String
  area          String
  address       String
  orderPrice    Decimal     @db.Decimal(10, 2)
  deliveryFee   Decimal     @db.Decimal(10, 2)
  prepMinutes   Int
  notes         String?
  status        OrderStatus @default(PENDING)
  isReady       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  business      Business    @relation(fields: [businessId], references: [id])
  courier       Courier?    @relation(fields: [courierId], references: [id])

  deliveryFeeReason        String  @default("NORMAL")
  deliveryFeeReasonDetails String?

  restaurantOrderId Int?             @unique
  restaurantOrder   RestaurantOrder? @relation(fields: [restaurantOrderId], references: [id])

  @@index([businessId, createdAt])
  @@index([courierId])
  @@index([status])
}

model Session {
  id         String    @id
  adminId    Int?
  businessId Int?
  courierId  Int?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime

  admin      Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  courier    Courier?  @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([businessId])
  @@index([courierId])
  @@index([expiresAt])
}

model DeliveryPricing {
  id            Int      @id @default(autoincrement())
  area          String   @unique
  fee           Decimal  @db.Decimal(10, 2)
  reason        String   @default("NORMAL")
  reasonDetails String?
  updatedAt     DateTime @updatedAt
}

enum RestaurantOrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  REJECTED
  CANCELED
}

model RestaurantOrder {
  id               Int                   @id @default(autoincrement())
  businessId       Int
  customerName     String
  customerPhone    String
  area             String
  address          String
  notes            String?
  status           RestaurantOrderStatus @default(PENDING)
  foodTotal        Decimal               @db.Decimal(10, 2)
  prepMinutes      Int?
  estimatedReadyAt DateTime?
  trackingToken    String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  business         Business              @relation(fields: [businessId], references: [id])
  items            RestaurantOrderItem[]

  deliveryOrder Order?

  @@index([businessId, status])
  @@index([createdAt])
}

model RestaurantOrderItem {
  id                Int             @id @default(autoincrement())
  restaurantOrderId Int
  productId         String
  productName       String
  size              String?
  quantity          Int
  unitPrice         Decimal         @db.Decimal(10, 2)
  toppings          Json?
  notes             String?

  restaurantOrder   RestaurantOrder @relation(fields: [restaurantOrderId], references: [id], onDelete: Cascade)
}


model MenuItem {
  id         Int      @id @default(autoincrement())
  businessId Int
  productId  String
  nameHe     String
  nameAr     String
  basePrice  Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)

  business   Business  @relation(fields: [businessId], references: [id])
  sizes      MenuItemSize[]
  toppings   MenuItemTopping[]

  @@unique([businessId, productId])
}

model MenuItemSize {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  size       String
  price      Decimal  @db.Decimal(10, 2)

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, size])
}

model MenuItemTopping {
  id         Int      @id @default(autoincrement())
  menuItemId Int
  toppingId  String
  nameHe     String
  nameAr     String
  extraPrice Decimal  @db.Decimal(10, 2)

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, toppingId])
}
